# HPC Claw backend settings
# Copy to .env for repo-local use or export these variables in your cluster shell.

HPC_ASSISTANT_OPENAI_API_KEY=replace-me
HPC_ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
HPC_ASSISTANT_OPENAI_MODEL=gpt-5
HPC_ASSISTANT_COMMAND_TIMEOUT_SECONDS=15.0
HPC_ASSISTANT_PGOA_STORE_PATH=~/.hpcassist
HPC_ASSISTANT_FILESYSTEM_ROOTS=["~","~/scratch"]
HPC_ASSISTANT_ALLOW_CLUSTER_PROBE_JOBS=false
HPC_ASSISTANT_GUARDRAILS_ENABLED=true
